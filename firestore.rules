rules_version = '2';

// Deploy via Firebase Console or: firebase deploy --only firestore:rules
// See docs/FIRESTORE_DEPLOY.md

service cloud.firestore {
  match /databases/{database}/documents {

    // User-scoped data: only the authenticated user may read/write their own subtree.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Community posts: any authenticated user can read; only authors can create/delete.
    match /community_posts/{post} {
      allow read: if request.auth != null;
      allow create: if request.auth != null 
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.body.size() <= 500;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Scans: only the owning user may create, update, read, or delete their own scans.
    // create checks request.resource (incoming data); update checks both the
    // existing document and the incoming data to prevent ownership changes.
    match /scans/{scan} {
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;
      allow read:   if request.auth != null
                    && resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }

    // Feedback and Expert Requests: an authenticated user can only create a
    // record stamped with their own uid (prevents spoofing another user's id).
    match /feedback/{item} {
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
    }
    match /expert_requests/{req} {
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
    }

    match /missing_crops/{crop} {
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
    }

    match /training_candidates/{candidate} {
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
    }

    // Outbreak reports: authenticated users can read; authors create their own.
    // Cap free-text notes to bound abuse / storage. Validate field types/ranges
    // so the crowd-sourced dataset stays clean, and keep reports immutable once
    // filed (no update/delete) for audit integrity.
    match /outbreak_reports/{report} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.disease is string
                    && request.resource.data.disease.size() <= 80
                    && (!('notes' in request.resource.data)
                        || request.resource.data.notes.size() <= 500)
                    && (!('severity' in request.resource.data)
                        || request.resource.data.severity in ['low','medium','high'])
                    && (!('confidence' in request.resource.data)
                        || (request.resource.data.confidence is number
                            && request.resource.data.confidence >= 0
                            && request.resource.data.confidence <= 1))
                    && (!('latitude' in request.resource.data)
                        || (request.resource.data.latitude is number
                            && request.resource.data.latitude >= -90
                            && request.resource.data.latitude <= 90))
                    && (!('longitude' in request.resource.data)
                        || (request.resource.data.longitude is number
                            && request.resource.data.longitude >= -180
                            && request.resource.data.longitude <= 180));
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verifiedBy', 'refutedBy']);
      allow delete: if false;
    }

    // Treatment plans synced to cloud.
    match /treatments/{treatment} {
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.userId == request.auth.uid;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
