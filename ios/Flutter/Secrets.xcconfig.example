# Copy this file to ios/Flutter/Secrets.xcconfig and fill in real values.
# Secrets.xcconfig is gitignored — never commit credentials.
#
# GOOGLE_MAPS_API_KEY  — iOS-restricted Maps SDK key from Google Cloud Console.
# DEVELOPMENT_TEAM     — Your 10-character Apple Team ID from
#                        https://developer.apple.com/account (Membership tab).
#                        Required for TestFlight and App Store builds.
#                        Xcode CODE_SIGN_STYLE is already set to Automatic;
#                        supplying the team ID here is all that is needed.

GOOGLE_MAPS_API_KEY = YOUR_IOS_GOOGLE_MAPS_API_KEY_HERE
DEVELOPMENT_TEAM = YOUR_APPLE_TEAM_ID_HERE
