 platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    # Remove PrivacyInfo.xcprivacy from PBXSourcesBuildPhase if any plugin incorrectly includes it there
    target.build_phases.each do |phase|
      if phase.is_a?(Xcodeproj::Project::Object::PBXShellScriptBuildPhase)
        if (phase.output_paths.nil? || phase.output_paths.empty?) && (phase.output_file_list_paths.nil? || phase.output_file_list_paths.empty?)
          phase.always_out_of_date = '1'
        end
      end

      if phase.respond_to?(:files)
        phase.files.each do |file|
          if file.file_ref && file.file_ref.respond_to?(:path) && file.file_ref.path.to_s.end_with?('PrivacyInfo.xcprivacy')
            if phase.is_a?(Xcodeproj::Project::Object::PBXSourcesBuildPhase)
              phase.remove_build_file(file)
              puts "Removed PrivacyInfo.xcprivacy from PBXSourcesBuildPhase for target: #{target.name}"
            end
          end
        end
      end
    end

    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      # Force Swift 5 mode and minimal concurrency checks for dependencies to prevent Swift 6 compile errors
      config.build_settings['SWIFT_VERSION'] = '5.0'
      config.build_settings['SWIFT_STRICT_CONCURRENCY'] = 'minimal'
      # Suppress deprecated-API warnings from third-party ObjC plugins (geolocator_apple,
      # image_picker_ios, permission_handler_apple, printing). These are upstream issues
      # that cannot be patched in-place; suppression is the correct workaround.
      config.build_settings['GCC_WARN_ABOUT_DEPRECATED_FUNCTIONS'] = 'NO'
      config.build_settings['CLANG_WARN_DEPRECATED_OBJC_IMPLEMENTATIONS'] = 'NO'
      # Suppress Swift warnings that are treated as errors in strict mode
      # (covers local_auth_darwin Swift 6 actor-isolation warnings and in_app_review check)
      config.build_settings['SWIFT_SUPPRESS_WARNINGS'] = 'YES'

      # Disable explicit module builds to prevent native dependency resolution errors
      config.build_settings['SWIFT_ENABLE_EXPLICIT_MODULES'] = 'NO'

      # Preserve symbols specifically for tflite_flutter dynamic native libraries
      # to prevent Xcode release/profile build symbol stripping from removing TensorFlowLite C symbols
      if target.name.downcase.include?('tflite') || target.name.downcase.include?('tensorflow')
        config.build_settings['STRIP_STYLE'] = 'non-global'
        config.build_settings['DEAD_CODE_STRIPPING'] = 'NO'
        config.build_settings['STRIP_INSTALLED_PRODUCT'] = 'NO'
      end

      # Enable permissions for permission_handler
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
        'PERMISSION_CAMERA=1',
        'PERMISSION_LOCATION=1',
        'PERMISSION_PHOTOS=1',
        'PERMISSION_MICROPHONE=1',
        'PERMISSION_NOTIFICATIONS=1',
        'PERMISSION_SPEECH_RECOGNIZER=1',
      ]
      if config.name == 'Release' && ENV['EXPORT_PROVISIONING_PROFILE']
        config.build_settings['CODE_SIGN_STYLE'] = 'Manual'
        config.build_settings['PROVISIONING_PROFILE_SPECIFIER'] = ENV['EXPORT_PROVISIONING_PROFILE']
      end
      config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
      config.build_settings['CODE_SIGNING_REQUIRED'] = 'NO'
    end
  end
end
