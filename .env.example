# Copy this file to .env and fill in real values.
# .env is gitignored and bundled inside the app binary at build time.
# Restrict every key in its cloud console to your app's bundle ID / SHA-256.
#
# CI: write the .env file from a masked CI secret before running flutter build.
# Example (GitHub Actions):
#   - run: echo "${{ secrets.DOT_ENV }}" > .env

# ── Supabase Backend ─────────────────────────────────────────────────────────
# Obtain from your Supabase project dashboard -> Settings -> API.
SUPABASE_URL=https://xrjltpchcssztitswjvm.supabase.co
SUPABASE_ANON_KEY=

# ── Google Sign-In / OAuth ───────────────────────────────────────────────────
# Web / Server Client ID configured in Google Cloud Console & Supabase Auth Provider
GOOGLE_SERVER_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# ── GhanaNLP (TTS / ASR) ─────────────────────────────────────────────────────
# Can also be supplied at build time via --dart-define=GHANA_NLP_SUBSCRIPTION_KEY=
GHANA_NLP_SUBSCRIPTION_KEY=

# ── Cloudinary (community image uploads) ─────────────────────────────────────
# Can also be supplied at build time via --dart-define=CLOUDINARY_CLOUD_NAME= etc.
# Get these values from your Cloudinary dashboard → Settings → Upload Presets.
# Use a SIGNED preset in production; restrict allowed origins in the Cloudinary console.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

# ── Google Maps ───────────────────────────────────────────────────────────────
# Android key → add GOOGLE_MAPS_API_KEY to android/local.properties (gitignored).
# iOS key     → add GOOGLE_MAPS_API_KEY to ios/Flutter/Secrets.xcconfig (gitignored).
# Neither key belongs in .env; they are injected at build time by the platform
# build system (Gradle manifestPlaceholders / Xcode xcconfig).

# ── Gemini Cloud AI Fallback ──────────────────────────────────────────────────
# Fallback multimodal crop disease diagnosis using Gemini 1.5 Flash.
# Obtain from https://aistudio.google.com/
# Can also be supplied via --dart-define=GEMINI_API_KEY=
GEMINI_API_KEY=

