  "apis": {
    "asr": {
      "productName": "Automatic Speech Recognition API",
      "version": "v3",
      "status": "ACTIVE",
      "deprecatedVersions": [
        "v1",
        "v2"
      ],
      "baseUrl": "https://translation-api.ghananlp.org",
      "endpoint": "/asr/v3/transcribe",
      "endpointVerified": "ASSUMED_FROM_PATTERN",
      "method": "POST",
      "authentication": {
        "headerName": "Ocp-Apim-Subscription-Key",
        "credentialType": "subscription_key",
        "storageLocation": "Supabase Secrets (server-side only)"
      },
      "request": {
        "contentType": "audio/wav",
        "body": "raw WAV bytes",
        "queryParams": {
          "language": "language code e.g. tw, ee, dag"
        },
        "audioRequirements": {
          "format": "WAV (PCM)",
          "sampleRate": 16000,
          "channels": 1,
          "maxDuration": "UNVERIFIED",
          "maxPayloadBytes": "UNVERIFIED"
        }
      },
      "response": {
        "contentType": "application/json OR text/plain",
        "fields": {
          "text": "transcript string \u2014 present when JSON response"
        },
        "confidenceField": "NOT_PROVIDED",
        "notes": "Response may be plain string OR JSON object with 'text' field \u2014 both must be handled"
      },
      "errors": {
        "400": "InvalidAudio",
        "401": "AuthenticationFailure",
        "403": "AuthenticationFailure",
        "429": "RateLimitExceeded",
        "500": "ProviderServerError",
        "503": "ProviderUnavailable"
      },
      "supportedLanguages": {
        "tw": {
          "name": "Twi",
          "verified": true
        },
        "ee": {
          "name": "Ewe",
          "verified": true
        },
        "dag": {
          "name": "Dagbani",
          "verified": true
        },
        "gaa": {
          "name": "Ga",
          "verified": false
        },
        "fat": {
          "name": "Fante",
          "verified": false
        }
      },
      "rateLimits": "UNVERIFIED",
      "timeoutRecommendation": "15 seconds"
    },
